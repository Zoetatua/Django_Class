{
  "version": 2,
  "builds": [
    {
      "src": "portofolio/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "static_root/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static_root/$1" },
    { "src": "/(.*)", "dest": "portofolio/wsgi.py" }
  ],
  "buildCommand": "bash build_files.sh"
}
